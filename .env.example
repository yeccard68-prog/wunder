# Copy to .env.local (never commit .env.local).

# --- App (public, bundled into the web/mobile app) ---
# Without these two values the app runs in clearly labelled demo mode.
# Project URL: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe to ship: all tables are protected by Row Level Security.
# NEVER put a secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: your own Amazon partner tag (e.g. name-21). Only then do books show a labelled shop link.
# Public by nature – it is part of every link. Shop domain defaults to amazon.de (the tag only works there
# if the partner account belongs to that marketplace).
NEXT_PUBLIC_AMAZON_PARTNER_TAG=
NEXT_PUBLIC_AMAZON_DOMAIN=

# --- Content pipeline only (pipeline/run.ts, runs on a server or your machine, never in the app) ---
# Claude API key for generating and checking questions
ANTHROPIC_API_KEY=
# Same project URL as above
SUPABASE_URL=
# Secret key (sb_secret_... / service_role). Bypasses RLS – keep it out of the app and out of source control.
SUPABASE_SERVICE_ROLE_KEY=
